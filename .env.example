# Copy to .env and fill in. Everything is optional: without keys the bot runs offline.
PORT=3000

# OpenAI-compatible API (classification + reply phrasing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=change-me

# Hand over to a manager below this classification confidence
HANDOVER_CONFIDENCE=0.55
